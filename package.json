{
  "name": "tutor-platform-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "家教撮合平台 - 微信小程序和H5",
  "scripts": {
    "dev:h5": "uni",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:workflows": "vitest run --config workspaces/chunxiaruo-commits/vitest.config.ts",
    "typecheck:workflows": "vue-tsc --noEmit -p workspaces/chunxiaruo-commits/tsconfig.json"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "leaflet": "^1.9.4",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.21",
    "typescript": "^5.4.5",
    "vite": "5.2.8",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": ">=20"
  }
}
