# Replace with your own domain. Local demonstration API, no production claim.
# Caddy obtains and renews HTTPS certificates when DNS/ports are configured.
demo.example.com {
  handle /api/* {
    reverse_proxy 127.0.0.1:3001
  }
  handle /health {
    reverse_proxy 127.0.0.1:3001
  }
  handle {
    root * /srv/tutor/dist/build/h5
    file_server
  }
}
