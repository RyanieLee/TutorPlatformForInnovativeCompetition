[Unit]
Description=Tutor platform controlled demo API
After=network.target

[Service]
Type=simple
User=tutordemo
Group=tutordemo
WorkingDirectory=/srv/tutor/server
Environment=NODE_ENV=development
EnvironmentFile=/etc/tutor-demo.env
ExecStart=/usr/bin/node /srv/tutor/server/dist/src/main.js
Restart=on-failure
RestartSec=3
StateDirectory=tutor-demo
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tutor-demo

[Install]
WantedBy=multi-user.target
