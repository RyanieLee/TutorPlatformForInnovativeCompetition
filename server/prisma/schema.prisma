generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  loginId       String             @unique
  displayName   String
  role          String
  status        String             @default("active")
  passwordHash  String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  teachingAttachments TeachingAttachment[]
  homeworkSubmissions HomeworkSubmission[]
  uploadQuotas UploadQuota[]
  sessions      Session[]
  tutorProfile  TutorProfile?
  application   TutorApplication?
  parentBookings Booking[]         @relation("ParentBookings")
  reports       Report[]           @relation("ReporterReports")
  auditLogs     AuditLog[]         @relation("ActorAuditLogs")

  @@index([role, status])
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model TutorProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String
  university   String
  major        String
  subjectsJson String
  teachingMode String
  area         String
  pricePerHour Int
  introduction String
  availability String
  photoKey     String?
  experienceMonths Int?
  academicScore Int?
  teachingSkillLevel Int?
  caseCount    Int?
  caseSummary  String @default("")
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  reports      Report[]
  subjects     TutorSubject[]

  @@index([published, createdAt])
}

model TutorSubject {
  tutorProfileId String
  subject        String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@id([tutorProfileId, subject])
  @@index([subject, tutorProfileId])
}

model TutorApplication {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  university      String
  major           String
  subjectsJson    String
  teachingMode    String
  area            String
  pricePerHour    Int
  introduction    String
  availability    String
  photoKey        String?
  experienceMonths Int?
  academicScore   Int?
  teachingSkillLevel Int?
  caseCount       Int?
  caseSummary     String @default("")
  status          String    @default("draft")
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, updatedAt])
}

model Booking {
  lessons        Lesson[]
  id             String       @id @default(cuid())
  parentId       String
  parent         User         @relation("ParentBookings", fields: [parentId], references: [id], onDelete: Restrict)
  tutorProfileId String
  requestId      String?
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Restrict)
  studentName    String
  subject        String
  expectedTime   String
  note           String       @default("")
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([parentId, requestId])
  @@index([parentId, createdAt])
  @@index([tutorProfileId, status, createdAt])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reporter       User         @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Restrict)
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Restrict)
  reason         String
  description    String       @default("")
  status         String       @default("open")
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([tutorProfileId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Lesson {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields:[bookingId], references:[id], onDelete:Restrict)
  title String
  scheduledAt DateTime
  previewText String @default("")
  homeworkText String
  dueAt DateTime?
  status String @default("draft")
  publishedAt DateTime?
  version Int @default(1)
  requestId String
  requestFingerprint String
  publishedFingerprint String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  uploads TeachingAttachment[]
  attachments LessonAttachment[]
  submissions HomeworkSubmission[]
  @@unique([bookingId,requestId])
  @@index([bookingId,status,scheduledAt,createdAt,id])
}
model TeachingAttachment {
  id String @id @default(cuid())
  lessonId String
  lesson Lesson @relation(fields:[lessonId],references:[id],onDelete:Restrict)
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
  purpose String
  originalName String
  mediaType String @default("")
  size Int @default(0)
  storageKey String @unique
  uploadState String @default("uploading")
  reservedBytes Int @default(0)
  quotaDate String
  expiresAt DateTime
  createdAt DateTime @default(now())
  lessonBinding LessonAttachment?
  submissionBinding SubmissionAttachment?
  @@index([uploadState,expiresAt])
}
model LessonAttachment {
  lessonId String
  lesson Lesson @relation(fields:[lessonId],references:[id],onDelete:Restrict)
  attachmentId String @unique
  attachment TeachingAttachment @relation(fields:[attachmentId],references:[id],onDelete:Restrict)
  @@id([lessonId,attachmentId])
}
model HomeworkSubmission {
  id String @id @default(cuid())
  lessonId String
  lesson Lesson @relation(fields:[lessonId],references:[id],onDelete:Restrict)
  parentId String
  parent User @relation(fields:[parentId],references:[id],onDelete:Restrict)
  revision Int
  requestId String
  requestFingerprint String
  note String
  submittedAt DateTime
  late Boolean
  attachments SubmissionAttachment[]
  @@unique([lessonId,revision])
  @@unique([parentId,requestId])
  @@index([lessonId,revision])
}
model SubmissionAttachment {
  submissionId String
  submission HomeworkSubmission @relation(fields:[submissionId],references:[id],onDelete:Restrict)
  attachmentId String @unique
  attachment TeachingAttachment @relation(fields:[attachmentId],references:[id],onDelete:Restrict)
  @@id([submissionId,attachmentId])
}
model UploadQuota {
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  day String
  usedBytes Int @default(0)
  reservedBytes Int @default(0)
  @@id([userId,day])
}
