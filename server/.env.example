NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL="file:./dev.db"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
SESSION_HOURS=24
# Only for local seed; choose your own strong passwords and never commit .env.
SEED_PARENT_PASSWORD=
SEED_TUTOR_PASSWORD=
SEED_ADMIN_PASSWORD=

# Optional OpenAI-compatible Chat Completions API for demand parsing.
# Leave unset for the existing no-key rule demo. Never place the key in VITE_*.
MATCH_MODEL_BASE_URL=
MATCH_MODEL_NAME=
MATCH_MODEL_API_KEY=
MATCH_MODEL_TIMEOUT_MS=8000

# Optional exam generation shares the above server-side model credentials.
EXAM_MODEL_TIMEOUT_MS=30000

# Optional companion chat timeout, clamped to 1000–30000ms. Reuses MATCH_MODEL_* credentials.
CHAT_MODEL_TIMEOUT_MS=15000
# Optional local portrait storage. Keep this directory private and backed up with the database.
TUTOR_PHOTO_ROOT=./.tutor-photos


# Optional vision-capable model for consent-based homework image review.
# If omitted, the endpoint falls back to MATCH_MODEL_*; the selected model must support image_url inputs.
# Images are sent to this model provider for inference and are not saved in the app database.
HOMEWORK_MODEL_BASE_URL=
HOMEWORK_MODEL_NAME=
HOMEWORK_MODEL_API_KEY=
HOMEWORK_MODEL_TIMEOUT_MS=45000
# 管理员模型接入（后台页面保存后即时生效）
# 持久化加密配置；默认只允许 DeepSeek。其他 HTTPS 域名由部署人员明确添加。
AI_CONFIG_FILE=./.ai-config/provider.enc
AI_ALLOWED_HOSTS=api.deepseek.com
# 可选：64 位十六进制随机密钥。留空时服务端生成并保存在配置目录，不能提交 Git。
AI_CONFIG_ENCRYPTION_KEY=
